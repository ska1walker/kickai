# Supabase (Region EU Frankfurt). Optional — die App läuft auch ohne (LocalStorage).
# Werte findest du im Supabase-Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Passwortschutz (Basic Auth). Beide leer lassen = kein Schutz (offene App).
# In Vercel als Environment Variables setzen, um Production zu schützen.
APP_USER=kai
APP_PASSWORD=

# KI-Statusvorschlag (optional). Ohne Key ist der KI-Button deaktiviert.
ANTHROPIC_API_KEY=
# Modell überschreibbar (Default claude-opus-4-8). Für geringere Kosten z.B.
# claude-haiku-4-5 oder claude-sonnet-4-6.
ANTHROPIC_MODEL=
# Quellen-Whitelist für die News-Suche (kommagetrennt). Leer = Standardliste
# (kicker.de, ligainsider.de, transfermarkt.de, sport1.de, bundesliga.com,
# fussballdaten.de). Die Suche ist hart auf diese Domains beschränkt.
NEWS_ALLOWED_DOMAINS=
# Quellen-Whitelist für den Talent-Scout (Kaderauswahl). Leer = Standardliste
# (dfb.de, transfermarkt.de, kicker.de, ligainsider.de, fussballdaten.de).
SCOUT_ALLOWED_DOMAINS=
# Quellen-Whitelist für die Team-Tier-Analyse (Kaderaufbau). Leer = Standardliste
# (kicker.de, transfermarkt.de, ligainsider.de, sport1.de, bundesliga.com).
TIERS_ALLOWED_DOMAINS=

# Täglicher News-Sammler (Cron). CRON_SECRET schützt /api/collect-news; Vercel
# sendet ihn als Bearer automatisch. Ohne Secret ist der Endpoint deaktiviert.
CRON_SECRET=
# Quellen-Whitelist für den News-Sammler. Leer = Standardliste
# (kicker.de, transfermarkt.de, ligainsider.de, sport1.de, bundesliga.com).
NEWS_COLLECT_ALLOWED_DOMAINS=
