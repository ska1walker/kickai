# Supabase (Region EU Frankfurt). Optional — die App läuft auch ohne (LocalStorage).
# Werte findest du im Supabase-Dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Passwortschutz (Basic Auth). Beide leer lassen = kein Schutz (offene App).
# In Vercel als Environment Variables setzen, um Production zu schützen.
APP_USER=kai
APP_PASSWORD=

# KI-Statusvorschlag (optional). Ohne Key ist der KI-Button deaktiviert.
ANTHROPIC_API_KEY=
# Modell überschreibbar (Default claude-opus-4-8). Für geringere Kosten z.B.
# claude-haiku-4-5 oder claude-sonnet-4-6.
ANTHROPIC_MODEL=
